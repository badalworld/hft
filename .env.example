# HFT — Trading Lifestyle Quant
# Server Binding Configuration (0.0.0.0 works for both Localhost PC and Online VPS Server)
HOST=0.0.0.0
PORT=3000

# Optional Master Vault Passphrase for encrypting Binance API credentials at rest in ./data/
HFT_VAULT_SECRET=trading-lifestyle-quant-hft-vault-key

# Optional Zero-Cost Local Decision Model Endpoint (Nimble via Ollama / Laya serve / Kev server)
# Leave blank to use the built-in sub-millisecond Calibrated System-1 RLCD Engine ($0 cost)
LOCAL_DECISION_PROVIDER=builtin
LOCAL_DECISION_ENDPOINT=http://127.0.0.1:11434
LOCAL_DECISION_MODEL=nimble
